# ==============================================================================
# Sentinel Relay Server — Production Environment Variables
# ==============================================================================

# Your public domain or subdomain pointing to your VPS IP (e.g. relay.sentinel.im)
# If testing locally on the VPS without a domain, set to your public IP or localhost
DOMAIN=relay.yourdomain.com

# Contact email for automatic Let's Encrypt TLS/SSL certificates
CONTACT_EMAIL=admin@yourdomain.com
